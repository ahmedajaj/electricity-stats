{
  "name": "electricity-stats",
  "version": "1.0.0",
  "description": "Electricity outage statistics for Kyiv, Sofii Rusovoi 7A (scraped from a public Telegram channel)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "prod": "NODE_ENV=production node src/server.js",
    "build": "npm --prefix web ci && npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "scrape": "node src/scraper.js",
    "gist:upload": "node src/gist-uploader.js",
    "gist:run": "node src/gist-runner.js"
  },
  "keywords": [
    "telegram",
    "electricity",
    "statistics"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.2.3",
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=20"
  }
}
